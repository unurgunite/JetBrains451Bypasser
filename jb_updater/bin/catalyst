#!/usr/bin/env bash
# Wrapper for Catalyst static performance analysis (dev dependency).
# Mirrors bin/lint: prefers prebuilt binary, falls back to crystal run.
set -e

cd "$(dirname "$0")/.."

if [ -x "./bin/catalyst-bin" ]; then
  ./bin/catalyst-bin "$@"
elif [ -f "lib/catalyst/src/catalyst.cr" ]; then
  crystal run lib/catalyst/src/catalyst.cr -- "$@"
else
  echo "catalyst not found: run 'shards install' first" >&2
  exit 1
fi
